<project name="Tone" default="run" basedir=".">

    <description>Compiles and runs the Tone music player</description>

    <property name="src.dir"   value="src" />
    <property name="dist.dir"  value="dist" />

    <presetdef name="javac">
        <javac includeantruntime="false" debug="true" />
    </presetdef>

    <target name="init">
        <mkdir dir="${dist.dir}" />
        <mkdir dir="${dist.dir}/classes" />
    </target>

    <target name="compile" depends="init" description="Compile source files">
        <javac srcdir="${src.dir}" destdir="${dist.dir}/classes" />
    </target>

    <target name="jar" depends="compile" description="Package into a JAR">
        <jar destfile="${dist.dir}/${ant.project.name}.jar" basedir="${dist.dir}/classes">
            <manifest>
                <attribute name="Main-Class" value="Tone" />
            </manifest>
        </jar>
    </target>

    <!-- If -Dsong is not provided on the command line, default to mary.txt -->
    <target name="songarg" unless="song">
        <property name="song" value="mary.txt" />
    </target>

    <!-- Run with default song, or override: ant run -Dsong=other.txt -->
    <target name="run" depends="jar,songarg" description="Run Tone (default: mary.txt)">
        <java jar="${dist.dir}/${ant.project.name}.jar" fork="true">
            <arg value="${basedir}/${song}" />
        </java>
    </target>

    <target name="clean" description="Remove compiled class files">
        <delete dir="${dist.dir}" />
    </target>

</project>